# ===============================
# Server Configuration
# ===============================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# ===============================
# Database Configuration
# ===============================
# MySQL database connection settings
# Required for Sequelize ORM
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rent_payment_db
DB_USER=root
DB_PASSWORD=password

# ===============================
# Authentication
# ===============================
# JWT secret key for token signing
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRE=7d

# ===============================
# M-Pesa Integration
# ===============================
# M-Pesa API credentials
# Get these from Daraja M-Pesa Developer Portal
MPESA_API_KEY=your-mpesa-api-key
MPESA_API_SECRET=your-mpesa-api-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback

# ===============================
# Bank Integration
# ===============================
# Bank API credentials (placeholder for future implementation)
BANK_API_KEY=your-bank-api-key
BANK_API_SECRET=your-bank-api-secret

# ===============================
# Email Configuration
# ===============================
# Gmail SMTP settings
# Note: Use Gmail App Password, not your regular password
# Enable 2FA and create App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@rentpayment.com

# ===============================
# Frontend Configuration
# ===============================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ===============================
# Logging
# ===============================
# Log level: debug, info, warn, error
LOG_LEVEL=debug
